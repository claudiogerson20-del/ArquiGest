NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>
# Só servidor — nunca expor no browser
SUPABASE_SERVICE_ROLE_KEY=<service role key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de dados Supabase (produção) — valor real só no .env.local ou no gestor de palavras-passe
SUPABASE_DB_NAME=ArquiGest
SUPABASE_DB_PASSWORD=<palavra-passe da base de dados>
